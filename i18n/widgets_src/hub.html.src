<!-- SunoForge v5.0 · [15] MY SUNO — the panel's first screen (DATA_SUNO_LIVE §7 MCP MENU) · CORE_00 §9 MENU UI · widgets/UI.md
Not connected: ONE screen — what this is, how to connect, what works without Suno; no grid of dead buttons.
Connected: the numbers as the header, then "via the main menu" (numbers and their codes) and "Suno only" (S-codes);
NO song is listed. A tap sends its code; the songs are widgets/songs.html, lists, picks and cards widgets/mcp.html.
S12–S15 live in a song's sheet, not here.
TRANSLATED COPIES: widgets/<lang>/hub.html is this template already translated — take it as it is. This English
copy is for English and for a language without a copy, where you translate the values of L (codes stay).
FILL ONLY the attributes of the root div, escaped for an attribute (& < > " ' as entities):
  data-mcp="on" | "off"   the Suno server in this session
  data-st="Pro · ≈1802 credits · used 698 of 2500 · downloads 19 · renews 01.12"   one line from account-usage
           (free; the balance lags 1–2 min, hence ≈), in the output language; "" when off. The same numbers are
           also written as text in the answer.
  data-mode="simple" | "extended"   USER_LEVEL (CORE_00 §9 MENU UI)
  data-last="1" when a finished prompt is in this conversation (S2 is drawn), else ""
Print the rest exactly as it is, this comment stripped: no re-indenting, nothing added. No emoji, no icons,
host colours only; the widget never calls a tool and never spends. -->
<h2 class="sr-only">{{t:suno_panel_your_suno_section}}</h2>
<style>.sh{font-size:14px;line-height:1.4;color:var(--text-primary)}.sh p{margin:0 0 8px}.sh-s{color:var(--text-secondary);font-size:12px}.sh-t{font-size:16px;font-weight:500}.sh-g{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin:0 0 8px}.sh button{font:inherit;color:inherit;text-align:left;padding:8px 10px;border:.5px solid var(--border);border-radius:var(--radius);background:var(--surface-1);cursor:pointer}.sh button:hover{border-color:var(--border-strong)}.sh-c{font-family:var(--font-mono);color:var(--text-accent);font-size:12px}.sh-n{font-weight:500}.sh small{display:block;font-size:12px;color:var(--text-secondary)}.sh-k{display:flex;flex-wrap:nowrap;gap:4px;align-items:center;margin-top:6px}.sh-k button{padding:2px 7px;font-size:12px}.sh details summary{cursor:pointer;color:var(--text-secondary);margin:2px 0 8px}.sh-v{margin-top:12px;font-size:11px;color:var(--text-secondary);display:flex;gap:4px;align-items:center;flex-wrap:wrap}</style>
<div class="sh" id="sh" data-mcp="on" data-st="{{t:pro_1802_credits_this_month_}}" data-mode="simple" data-last=""><span class="sh-s">{{t:if_the_screen_did_not_start}}</span></div>
<script>(function(){var R=document.getElementById('sh');if(!R)return;var L=%%L%%;var off=R.getAttribute('data-mcp')==='off',md=R.getAttribute('data-mode')==='extended'?'extended':'simple',last=R.getAttribute('data-last')==='1';var MM=[['1','c1','c1_n'],['2','c2'],['14','sp'],['12b','ch','ch_n'],['13a','st','st_n']],SO=[['S1','so','so_n',1],['S2','sd','sd_n'],['S3','snd','snd_n'],['S4','fr','fr_n'],['S5','lo','lo_n'],['S6','mi','mi_n'],['S7','up','up_n'],['S8','vo','vo_n'],['S9','pl'],['S10','ws','ws_n'],['S11','cp'],['S11 upgrade','mc']],TOP=['S1','S2','S11','12b','13a'];function say(t){if(typeof sendPrompt==='function'){sendPrompt(t);return}var p=document.getElementById('sh-fb')||el('p','sh-s');p.id='sh-fb';p.textContent=L.type+' '+t;R.appendChild(p)}function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}function item(x){var b=el('button'),c=x[0]==='S11 upgrade'?'S11':x[0];b.appendChild(el('span','sh-c',/^\d+$/.test(c)?'['+c+']':c));b.appendChild(document.createTextNode(' '));b.appendChild(el('span','sh-n',L[x[1]]));if(x[2])b.appendChild(el('small',0,L[x[2]]));b.onclick=function(){say((x[3]?x[0]+' 10':x[0])+' · '+L[x[1]])};if(!x[3])return b;var d=el('div');b.style.width='100%';d.appendChild(b);var k=el('div','sh-k');k.appendChild(el('span','sh-s',L.show));[['10','10'],['50',L.list50]].forEach(function(n){var c=el('button',0,n[1]);c.onclick=function(){say('S1 '+n[0]+' · '+L.so)};k.appendChild(c)});d.appendChild(k);return d}function grid(a){var g=el('div','sh-g');a.forEach(function(x){g.appendChild(item(x))});return g}function view(){var v=el('div','sh-v');v.appendChild(el('span',0,L.view));[['w',L.vm],['t',L.vt],['b',L.vb]].forEach(function(x,i){var b=el('button',i?'':'on',x[1]);b.style.cssText='font-size:11px!important;line-height:1.5!important;padding:1px 9px!important;min-height:0!important;height:auto!important;width:auto!important;border:0.5px solid var(--border)!important;border-radius:99px!important;background:transparent!important;color:var(--text-secondary)!important;font-weight:400!important'+(i?'':';color:var(--text-accent)!important;border-color:var(--border-accent)!important;background:var(--bg-accent)!important;font-weight:500!important');b.onclick=function(){say(x[0])};v.appendChild(b)});R.appendChild(v)}var home=[['menu','menu']];R.innerHTML='';if(off){R.appendChild(el('p','sh-t','[15] '+L.title));R.appendChild(el('p',0,L.off_what));R.appendChild(el('p','sh-s',L.off_how));R.appendChild(el('p',0,L.off_wo));var g=el('div','sh-g');[['1','c1'],['2','c2'],['7','c7']].forEach(function(x){g.appendChild(item(x))});var m=el('button',0,'← '+L.menu);m.onclick=function(){say('menu · '+L.menu)};g.appendChild(m);R.appendChild(g);view();return}var st=R.getAttribute('data-st')||'';R.appendChild(el('p','sh-t','[15] '+L.title+(st?' — '+st:'')));R.appendChild(el('p','sh-s',L.what+' '+L.try));R.appendChild(el('p','sh-s',(md==='simple'?L.hn:L.hp)));var so=SO.filter(function(x){return x[0]!=='S2'||last});var mb=el('button',0,'← '+L.menu);mb.onclick=function(){say('menu · '+L.menu)};if(md==='simple'){var top=MM.concat(so).filter(function(x){return TOP.indexOf(x[0])>=0}).sort(function(a,b){return TOP.indexOf(a[0])-TOP.indexOf(b[0])});R.appendChild(grid(top));var d=el('details');d.appendChild(el('summary',0,L.more));d.appendChild(el('p','sh-s',L.g_mm));d.appendChild(grid(MM.filter(function(x){return TOP.indexOf(x[0])<0})));d.appendChild(el('p','sh-s',L.g_so));d.appendChild(grid(so.filter(function(x){return TOP.indexOf(x[0])<0})));d.appendChild(el('p','sh-s',L.song_n));R.appendChild(d)}else{R.appendChild(el('p','sh-s',L.g_mm));R.appendChild(grid(MM));R.appendChild(el('p','sh-s',L.g_so));R.appendChild(grid(so));R.appendChild(el('p','sh-s',L.song_n))}var a=el('details');a.appendChild(el('summary',0,L.appt));a.appendChild(el('p','sh-s',L.app));R.appendChild(a);var gm=el('div','sh-g');gm.appendChild(mb);R.appendChild(gm);view()})();</script>
